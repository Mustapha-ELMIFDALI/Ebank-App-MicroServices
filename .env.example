# Copy to .env (ignored by git) and fill in.

# At least 32 random characters. scripts/start-all.ps1 creates it when it is empty
JWT_SECRET=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, default gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.8-flash

# Telegram: create a bot with @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Required to use the bot. Send it a message, it replies with your id
TELEGRAM_ALLOWED_USERS=

# Discord: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
# Required to use the bot. Send it a message, it replies with your id
DISCORD_ALLOWED_USERS=
